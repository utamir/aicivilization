{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true, "allowImportingTsExtensions": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "types": []
  },
  "include": ["src/sim/**/*.ts", "tools/**/*.ts"],
  "exclude": ["src/sim/__tests__/**"]
}
